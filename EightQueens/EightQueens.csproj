<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>EightQueens</RootNamespace>
    <AssemblyName>EightQueens</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Properties\AssemblyInfo.cs already declares the assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The .resx files embed images (non-string resources), which the dotnet CLI needs this for -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

</Project>
